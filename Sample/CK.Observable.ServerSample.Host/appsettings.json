{
  "CK-Monitoring": {
    "LogPath": "Logs",
    "HandleDotNetLogs": true,
    "GrandOutput": {
      "MinimalFilter": "Debug",
      "Handlers": {
        "Console": true,
        "TextFile": {
          "Path": "Text"
        }
      }
    }
  },
  "CK-ObservableLeague": {
    "StorePath": "domain-store"
  },
  "MQTTDemiServerConfig": {
    "ListenTo": [
      "tcp:1883",
      "ws:http://localhost:8080/"
    ]
  },
  "CK-AppIdentity": {
    "FullName": "CK-Observable/$ServerSample",
    "Local": {
      "AllowFeatures": "HttpEndpoint",
      "HttpEndpoint": {
        "Main": {
          "Urls": "http://localhost:5600"
        }
      },
      "Client": {
        "ObservableDomainNgSample": {}
      },
      "PartyClient": { "ObservableDomainNgSample": {} }
    }
  }
}
